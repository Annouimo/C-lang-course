// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.

[
  {
    "label": "C: Compile and Run",
    "command": "clang",
    "args": [
      "-g", "$ZED_FILE",
      "-o", "$ZED_DIRNAME/$ZED_STEM",
      "&&", "$ZED_DIRNAME/$ZED_STEM"
    ],
    "tags": ["c-main"],
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "C++: Compile and Run",
    "command": "clang++",
    "args": [
      "-g", "$ZED_FILE",
      "-o", "$ZED_DIRNAME/$ZED_STEM",
      "&&", "$ZED_DIRNAME/$ZED_STEM"
    ],
    "tags": ["cpp-main"],
    "use_new_terminal": false,
    "reveal": "always"
  },
  {
    "label": "C/C++: Compile with Warnings",
    "command": "clang",
    "args": [
      "-Wall", "-Wextra", "-g", "$ZED_FILE",
      "-o", "$ZED_DIRNAME/$ZED_STEM"
    ],
    "use_new_terminal": false,
    "reveal": "always"
  }
]
